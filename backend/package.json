{
  "name": "vynorai-backend",
  "version": "1.0.0",
  "description": "VynorAI Cloud Backend - Auth, PayHere Subscriptions & AI Proxy",
  "main": "dist/index.js",
  "scripts": {
    "dev": "tsx watch src/index.ts",
    "build": "tsc",
    "test:security": "tsx --test test/*.test.ts",
    "smoke:release": "node scripts/release-smoke.mjs",
    "test:quota": "npm run build && node test_quota_concurrency.mjs",
    "start": "node dist/index.js",
    "prod:start": "pm2 start ecosystem.config.cjs",
    "prod:reload": "pm2 reload ecosystem.config.cjs",
    "prod:stop": "pm2 stop ecosystem.config.cjs"
  },
  "dependencies": {
    "bcryptjs": "^2.4.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.7",
    "express": "^4.21.2",
    "jsonwebtoken": "^9.0.2",
    "nodemailer": "^10.0.13",
    "pg": "^8.16.3",
    "redis": "^5.8.2",
    "sqlite3": "^5.1.7",
    "uuid": "^11.1.0",
    "web-push": "^3.6.7"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^5.0.0",
    "@types/jsonwebtoken": "^9.0.9",
    "@types/node": "^22.13.9",
    "@types/nodemailer": "^8.0.2",
    "@types/pg": "^8.15.5",
    "@types/sqlite3": "^3.1.11",
    "@types/uuid": "^10.0.0",
    "@types/web-push": "^3.6.4",
    "tsx": "^4.19.3",
    "typescript": "^5.7.3"
  }
}
