{
  "name": "vynor-background-runner",
  "version": "1.0.0",
  "private": true,
  "type": "module",
  "scripts": {
    "build": "tsc -p tsconfig.json --noEmit && esbuild src/index.ts --bundle --platform=node --format=esm --target=node20 --outfile=dist/index.js --external:yauzl",
    "start": "node dist/index.js"
  },
  "dependencies": {
    "async-mutex": "^0.5.0",
    "diff": "^8.0.3",
    "yauzl": "^3.2.0"
  },
  "devDependencies": {
    "@types/diff": "^7.0.1",
    "@types/node": "^22.13.9",
    "@types/yauzl": "^2.10.3",
    "esbuild": "^0.25.0",
    "typescript": "^5.7.3"
  }
}
