# Public entry point for the VPS (docker-compose.vps.yml).
# Both hosts are proxied by Cloudflare, which serves the public certificate.
# Cloudflare's "Always Use HTTPS" blocks Let's Encrypt HTTP-01 at the origin,
# so Caddy uses its own origin certificate: set Cloudflare SSL/TLS to "Full".
# To move to "Full (strict)", install a Cloudflare Origin CA certificate and
# replace `tls internal` with `tls /certs/origin.pem /certs/origin.key`.
{
	# Origin is reachable only through Cloudflare; no ACME account needed.
	auto_https disable_redirects
}

# Two backend workers. One user's requests stick to one worker (hash of the
# Authorization header) so per-worker memos keep the provider prefix cache
# warm; a worker that fails /ready (crash, or draining during a rolling
# deploy) is skipped and its users move to the other worker.
(backend_pool) {
	lb_policy header Authorization
	lb_retries 2
	lb_try_duration 5s
	lb_try_interval 250ms
	health_uri /ready
	health_port 3333
	health_interval 2s
	health_timeout 2s
	health_status 200
}

(cloudflare_client_ip) {
	# Cloudflare sends the visitor IP here. Express trusts one proxy hop, so a
	# single-entry X-Forwarded-For gives rate limits and logs the real client.
	header_up X-Forwarded-For {http.request.header.CF-Connecting-IP}
	header_up X-Real-IP {http.request.header.CF-Connecting-IP}
}

vynor.lk {
	tls internal
	encode zstd gzip
	# Office.js task-pane assets. This is served before the API proxy so OAuth
	# redirects and Excel load the exact public HTTPS origin in the manifest.
	handle_path /m365/* {
		# Everything is revalidated except versioned files. A build id in ?v= never changes the bytes behind
		# its URL, so those (and the content-hashed chunks) are cached at the edge and in the browser for a
		# year: only the first open of a build reaches the origin (Cloudflare to origin was intermittently
		# slow or failing, and a 1 MB miss is where the pane used to hang).
		@live expression `!path('/dist/*') && !((path('/pane.css') || path('/runtime-config.js')) && {http.request.uri.query.v} != "")`
		header @live Cache-Control "no-cache"
		@versioned expression `((path('/dist/*') || path('/pane.css') || path('/runtime-config.js')) && {http.request.uri.query.v} != "") || path('/dist/chunks/*')`
		header @versioned Cache-Control "public, max-age=31536000, immutable"
		root * /srv/m365
		file_server
	}
	# Worker/model-relay endpoints are reachable only on vynor-net. Never route
	# them from the public origin, even when a caller has a scoped token.
	@internal path /internal/*
	respond @internal 404
	handle {
		reverse_proxy vynor-backend:3333 vynor-backend-2:3333 {
			import backend_pool
			import cloudflare_client_ip
			# Model responses stream over SSE; never buffer them.
			flush_interval -1
		}
	}
}

admin.vynor.lk {
	tls internal
	encode zstd gzip
	# Defence in depth for the admin API: the backend verifies the signed Cf-Access-Jwt-Assertion
	# (it never trusts the e-mail header alone), and here the Access headers are dropped from any
	# request that reached the origin without passing through Cloudflare. The ranges below are
	# Cloudflare's published edge list (https://www.cloudflare.com/ips/): re-check them when
	# Cloudflare announces a change. If the list goes stale, Cloudflare-Access sign-in stops working
	# but the ADMIN_SECRET path still does (no lockout). NOT validated with `caddy validate` yet.
	@direct not remote_ip 173.245.48.0/20 103.21.244.0/22 103.22.200.0/22 103.31.4.0/22 141.101.64.0/18 108.162.192.0/18 190.93.240.0/20 188.114.96.0/20 197.234.240.0/22 198.41.128.0/17 162.158.0.0/15 104.16.0.0/13 104.24.0.0/14 172.64.0.0/13 131.0.72.0/22 2400:cb00::/32 2606:4700::/32 2803:f800::/32 2405:b500::/32 2405:8100::/32 2a06:98c0::/29 2c0f:f248::/32
	handle @direct {
		reverse_proxy vynor-backend:3334 vynor-backend-2:3334 {
			import backend_pool
			import cloudflare_client_ip
			header_up -Cf-Access-Authenticated-User-Email
			header_up -Cf-Access-Jwt-Assertion
		}
	}
	handle {
		reverse_proxy vynor-backend:3334 vynor-backend-2:3334 {
			import backend_pool
			import cloudflare_client_ip
		}
	}
}
