# VynorAI production backend environment (VPS, docker-compose.vps.yml).
# Copy to backend/.env on the server. Never commit the filled file.
# Values marked __GENERATE__ are filled by deploy/init-env.sh with openssl.

NODE_ENV=production
PORT=3333
ADMIN_PORT=3334
BASE_URL=https://vynor.lk
ADMIN_ORIGIN=https://admin.vynor.lk
CORS_ORIGINS=https://vynor.lk,https://admin.vynor.lk

# ─── Secrets (generated on the server) ─────────────────────────────────────────
JWT_SECRET=__GENERATE__
ADMIN_SECRET=__GENERATE__
# Cloudflare Access (admin.vynor.lk). BOTH are required for Access sign-in; without them only ADMIN_SECRET works.
# Team domain: Zero Trust > Settings > Custom Pages (your-team.cloudflareaccess.com). AUD: Access > Applications > the admin app > Overview.
CF_ACCESS_TEAM_DOMAIN=
CF_ACCESS_AUD=
DATA_ENCRYPTION_KEY=__GENERATE__

# ─── AI providers (fill in) ────────────────────────────────────────────────────
# Direct DeepSeek is the cheapest path for the Auto router (Flash / V4 Pro).
DEEPSEEK_API_KEY=
DEEPSEEK_CHAT_MODEL=deepseek-flash
DEEPSEEK_PRO_MODEL=deepseek-v4-pro
# Fallback when DeepSeek is down, and for non-DeepSeek models.
OPENROUTER_API_KEY=
VYNOR_PROVIDER_STRATEGY=direct-first

# ─── PayHere (fill in; switch to live after a sandbox test payment) ───────────
PAYHERE_ENV=sandbox
PAYHERE_MERCHANT_ID=
PAYHERE_MERCHANT_SECRET=
PAYHERE_RETURN_URL=https://vynor.lk/dashboard.html?payment=success
PAYHERE_CANCEL_URL=https://vynor.lk/dashboard.html?payment=cancel
PAYHERE_NOTIFY_URL=https://vynor.lk/api/payment/notify

# ─── Database ──────────────────────────────────────────────────────────────────
# DATABASE_URL (PostgreSQL) is appended by deploy/init-env.sh. Without it the
# backend falls back to SQLite in /app/data, which is for local development only.
IDE_AUTH_REQUIRE_REDIS=false

# ─── Email (optional: password reset, receipts) ───────────────────────────────
# RESEND_API_KEY=
# EMAIL_FROM=VynorAI <no-reply@vynor.lk>

# ─── Google sign-in (optional; the button appears once both are set) ──────────
# Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web).
# Authorized redirect URI: https://vynor.lk/api/auth/google/callback
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# Cloud delivery provenance: public verification key only (never put a private key here).
# Use a single-line PEM with literal `\n` escapes when injected by the secret manager.
CLOUD_ARTIFACT_KEY_ID=release-key-2026
CLOUD_ARTIFACT_PUBLIC_KEY_PEM=
# Optional operator-owned controller used by the cloud deployment adapter.
# It must be HTTPS and the token is never sent to the model or stored in manifests.
CLOUD_DEPLOYMENT_CONTROLLER_URL=
CLOUD_DEPLOYMENT_CONTROLLER_TOKEN=

# Microsoft 365 / Excel add-in (Entra ID). Tenants are enabled per organisation in the admin portal.
# M365_ENTRA_CLIENT_ID=            # the add-in (SPA) app registration
# M365_ENTRA_API_CLIENT_ID=        # the API app registration the backend validates tokens for
# M365_ENTRA_API_AUDIENCE=         # e.g. api://<api-client-id>
# M365_ENTRA_TENANT_ID=            # home tenant; ignored when M365_ENTRA_MULTI_TENANT=true
# M365_ENTRA_MULTI_TENANT=true
# M365_ENTRA_ALLOWED_CLIENT_IDS=   # comma-separated client ids allowed to call the API
# M365_ENTRA_CLIENT_SECRET=        # only for the on-behalf-of Graph path; never commit a real value
# M365_ENTRA_AUTHORITY=            # optional override, default https://login.microsoftonline.com/organizations
# M365_ENTRA_ISSUER=               # optional override
# M365_ENTRA_JWKS_URL=             # optional override

# Shared cache and rate limits across the two backend workers (docker-compose.vps.yml sets it for the stack).
# REDIS_URL=redis://vynor-redis:6379

# Transactional e-mail (verification, password reset). Without it mails are only logged.
# SMTP_HOST=
# SMTP_PORT=587
# SMTP_SECURE=false
# SMTP_USER=
# SMTP_PASS=
# SMTP_FROM="VynorAI <no-reply@vynor.lk>"

# Cloudflare Turnstile on sign-up and sign-in (leave empty to disable).
# TURNSTILE_SITE_KEY=
# TURNSTILE_SECRET_KEY=

# Process tuning (defaults are fine for the 6 GB VPS).
# PG_POOL_MAX=10
# SHUTDOWN_DRAIN_MS=
# SHUTDOWN_TIMEOUT_MS=
# AI_MAX_CONCURRENT=            # global cap on simultaneous model calls
# AI_PROVIDER_MAX_CONCURRENT=   # per-provider cap
# AI_ADMISSION_WAIT_MS=         # how long a request may wait for a slot

# PostgreSQL transport. TLS is required unless the host is loopback, a single-label docker name
# (vynor-postgres), *.internal or a private IPv4 address. PG_SSL=require forces TLS, PG_SSL=disable
# is the only way to run without TLS against a remote host.
# PG_SSL=

# M365 tenants allowed to sign in (comma-separated tenant ids). Empty = every tenant an administrator
# has enabled in the admin portal; set it only to restrict a single-organisation deployment.
# M365_ALLOWED_TENANT_IDS=

# Other providers (optional; models appear in the router only when the key is set).
# ANTHROPIC_API_KEY=
# OPENAI_API_KEY=
# GEMINI_API_KEY=
# GROQ_API_KEY=

# Semantic cache (needs the local embedding model; off by default).
# SEMANTIC_CACHE_ENABLED=false
# SEMANTIC_CACHE_THRESHOLD=0.95
# SEMANTIC_CACHE_SCOPE=user     # user | global

# Releases served to the extension updater (mounted read-only from /opt/vynor/releases).
# RELEASES_DIR=/app/releases

# Background agents. docker-compose.vps.yml sets BG_ENABLED, the launcher socket, the relay and the
# staging path. In production these three MUST be set to long random values (the backend refuses to
# start the background routes without them):
#   openssl rand -hex 32
# BG_MODEL_TOKEN_SECRET=
# BG_QUOTE_SECRET=
# BG_ARTIFACT_MASTER_KEY=         # base64 of 32 random bytes: openssl rand -base64 32
# BG_IP_HASH_SALT=
# Web push for task notifications (npx web-push generate-vapid-keys).
# BG_VAPID_PUBLIC_KEY=
# BG_VAPID_PRIVATE_KEY=
# BG_VAPID_SUBJECT=mailto:admin@vynor.lk
# Signed patch uploads from the extension (public key only).
# BG_PATCH_SIGNING_KEY_ID=
# BG_PATCH_SIGNING_PUBLIC_KEY_BASE64=
# Limits (defaults are fine).
# BG_MAX_UPLOAD_BYTES=
# BG_MAX_PATCH_BYTES=
# BG_MIN_AVAILABLE_MB=
# BG_MIN_AVAILABLE_DISK_MB=
# BG_COMPUTE_CREDITS_PER_HOUR=
# BG_EGRESS_ALLOWLIST=            # comma-separated hosts a sandboxed task may reach
# BG_STAGING_GRACE_MINUTES=
# BG_ARTIFACT_DIR=
